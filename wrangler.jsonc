// Cloudflare Workers – static site (no server code, assets only)
// Deploy: npm run deploy:worker  →  https://loi-chuc-gui-me.<your-subdomain>.workers.dev
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loi-chuc-gui-me",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}

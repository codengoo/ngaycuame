// Cloudflare Workers – static site + a tiny API for the heart counter
// Deploy: npm run deploy  →  https://guimecuacon.nghiacn.cloud
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loi-chuc-gui-me",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Only the API reaches the Worker; pages and files are served straight from the assets
    "run_worker_first": ["/api/*"]
  },
  // Heart counts (schema in migrations/)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loi-chuc-gui-me",
      "database_id": "616a248d-db85-4f73-8bcb-540fba329c51"
    }
  ]
}
